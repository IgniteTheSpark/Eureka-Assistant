# Theme V2 owns an independent Compose project, database, and volumes.
THEME_V2_ENV=dev
THEME_V2_API_HOST_PORT=8100
THEME_V2_MYSQL_HOST_PORT=3307
THEME_V2_DB_PASSWORD=change-me
THEME_V2_DB_ROOT_PASSWORD=change-root-password
THEME_V2_JWT_SECRET=change-to-a-long-random-secret

# Hardware capture providers. Short files use phone-side ASR; large files use
# the durable server-side Tencent task worker.
TENCENT_ASR_SERVICE_BASE_URL=https://pre.card.biz
CAPTURE_ASR_POLL_INTERVAL_SECONDS=5
CAPTURE_ASR_POLL_TIMEOUT_SECONDS=1800
CAPTURE_PROVIDER_TIMEOUT_SECONDS=20

# Capture organization is opt-in until a model and key are configured.
CAPTURE_AGENT_ENABLED=false
CAPTURE_AGENT_MODEL=
CAPTURE_AGENT_API_KEY=
CAPTURE_AGENT_TIMEOUT_SECONDS=60
CAPTURE_AGENT_MAX_ATTEMPTS=3

# Report providers are opt-in. Enable only after configuring the capability model.
REPORT_PLANNER_ENABLED=false
REPORT_PIPELINE_ENABLED=false
REPORT_PLANNER_MODEL=
REPORT_GENERATOR_MODEL=
REPORT_ILLUSTRATION_MODEL=
REPORT_PROVIDER_API_KEY=
REPORT_PROVIDER_TIMEOUT_SECONDS=60
REPORT_PROVIDER_MAX_ATTEMPTS=3

# Web Search selects Bocha first, then Tavily.
BOCHA_API_KEY=
BOCHA_API_URL=https://api.bochaai.com/v1/web-search
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
REPORT_WEB_TIMEOUT_SECONDS=20

# OpenAI-compatible image endpoint; illustration remains optional.
REPORT_ILLUSTRATION_API_URL=
REPORT_PUBLIC_BASE_URL=http://localhost:8100
