                  "x": 16,
                  "y": 16,
                  "name": "Motion Spec Heading",
                  "fill": "$theme-v2/fg",
                  "content": "04  资产泡泡池",
                  "fontFamily": "$theme-v2/font-primary",
                  "fontSize": 14,
                  "fontWeight": "650"
                },
                {
                  "type": "text",
                  "id": "d4CKu3",
                  "x": 16,
                  "y": 50,
                  "name": "Motion Spec Body",
                  "fill": "$theme-v2/muted",
                  "textGrowth": "fixed-width",
                  "width": 400,
                  "content": "泡泡尺寸为 30–80px 的稳定随机值（asset_id 作为种子），没有业务含义。最新 1–5 个按生成顺序使用渐变球壳；第 6 个起退回主题中性球壳。新 Asset 放大入场并沉降，排名变化只更新颜色，不改变尺寸。",
                  "lineHeight": 1.55,
                  "fontFamily": "$theme-v2/font-primary",
                  "fontSize": 11,
                  "fontWeight": "450"
                }
              ]
            }
          ]
