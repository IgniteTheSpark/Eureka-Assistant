                  "content": "01 · TODAY-ONLY RUNTIME",
                  "fontFamily": "$theme-v2/font-primary",
                  "fontSize": 14,
                  "fontWeight": "650"
                },
                {
                  "type": "text",
                  "id": "ONWfX",
                  "x": 16,
                  "y": 50,
                  "name": "Motion Spec Body",
                  "fill": "$theme-v2/muted",
                  "textGrowth": "fixed-width",
                  "width": 400,
                  "content": "当前 Home 只渲染 Today，secondaryLayer = null。不露出背板、Goal 页头、数量、箭头、切换器、edge reveal 或占位，也不注册横向切层手势；历史第二层状态进入时归一为 Today。",
                  "lineHeight": 1.55,
                  "fontFamily": "$theme-v2/font-primary",
                  "fontSize": 11,
                  "fontWeight": "450"
                }
              ]
            },
            {
              "type": "frame",
              "id": "k66Mv5",
              "x": 490,
              "y": 92,
              "name": "Motion Spec / 02  下一时刻",
              "width": 434,
              "height": 170,
              "fill": "$theme-v2/surface",
              "cornerRadius": 14,
              "stroke": "$theme-v2/border",
              "strokeWidth": 1,
              "layout": "none",
              "children": [
