<!doctype html>
<html lang="zh-CN" data-color-scheme="{{ color_scheme }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ title }}</title>
  <style>{{ report_css | safe }}</style>
</head>
<body>
  <main class="report {{ palette }} {{ surface }}">
    {{ masthead_html | safe }}
    <article class="r-body">{{ body_html | safe }}</article>
    {{ actions_html | safe }}
    {{ sources_html | safe }}
    <footer class="r-sign">
      <div class="r-sign-mark">REKA INSIGHTS</div>
      <div class="r-sign-tag">Reka 为你整理</div>
    </footer>
  </main>
</body>
</html>
