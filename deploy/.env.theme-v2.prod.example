# Copy to deploy/.env.theme-v2.prod on the server. Never commit the real file.
# DOMAIN must already resolve to the server before Caddy can issue TLS.
DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# The deploy script replaces this with the current Git SHA. Keep a non-empty
# value so `docker compose config` can also be run directly.
APP_IMAGE_TAG=replace-with-git-sha
# Mainland China defaults. Use deb.debian.org and https://pypi.org/simple when
# the VM has reliable international package access.
DEBIAN_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

MYSQL_DATABASE=eureka_theme_v2
MYSQL_USER=theme_v2
THEME_V2_DB_PASSWORD=replace-with-a-long-random-password
THEME_V2_DB_ROOT_PASSWORD=replace-with-another-long-random-password
# URL-encode special characters in the password embedded in this URL.
THEME_V2_DATABASE_URL=mysql://theme_v2:replace-with-url-encoded-password@db:3306/eureka_theme_v2
THEME_V2_JWT_SECRET=replace-with-openssl-rand-hex-32

DEFAULT_USER_TIMEZONE=Asia/Shanghai
# Mobile voice input uses the Qwen streaming gateway hosted by Theme V2.
STREAMING_ASR_ENABLED=true
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_ASR_WS_URL=wss://replace-with-workspace-id.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
ALI_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
ASR_RATE_LIMIT_PER_MINUTE=10
ASR_PROVIDER_START_TIMEOUT_SECONDS=8
ASR_PROVIDER_SEND_TIMEOUT_SECONDS=3
ASR_PROVIDER_FINALIZE_TIMEOUT_SECONDS=10
ASR_PROVIDER_CLEANUP_TIMEOUT_SECONDS=2
ASR_CLIENT_SEND_TIMEOUT_SECONDS=2

# Existing hardware recordings still use the completed-file provider below.
TENCENT_ASR_SERVICE_BASE_URL=https://pre.card.biz
CAPTURE_ASR_POLL_INTERVAL_SECONDS=5
CAPTURE_ASR_POLL_TIMEOUT_SECONDS=1800
CAPTURE_PROVIDER_TIMEOUT_SECONDS=20

# The product can boot with providers disabled, but AI capture/chat/reporting
# remains unavailable until the matching model and key are configured.
CAPTURE_AGENT_ENABLED=false
CAPTURE_AGENT_MODEL=
CAPTURE_AGENT_API_KEY=
CAPTURE_AGENT_TIMEOUT_SECONDS=60
CAPTURE_AGENT_MAX_ATTEMPTS=3
CHAT_AGENT_ENABLED=false
CHAT_AGENT_MODEL=
CHAT_AGENT_API_KEY=
CHAT_AGENT_TIMEOUT_SECONDS=60
CAPTURE_FLASH_WAIT_SECONDS=20
CAPTURE_FLASH_POLL_INTERVAL_SECONDS=0.05

REPORT_PLANNER_ENABLED=false
REPORT_PIPELINE_ENABLED=false
REPORT_PLANNER_MODEL=
REPORT_GENERATOR_MODEL=
REPORT_ILLUSTRATION_ENABLED=false
REPORT_ILLUSTRATION_MODEL=
REPORT_ILLUSTRATION_API_KEY=
REPORT_ILLUSTRATION_TIMEOUT_SECONDS=90
REPORT_PROVIDER_API_KEY=
REPORT_PROVIDER_TIMEOUT_SECONDS=60
REPORT_PROVIDER_MAX_ATTEMPTS=3
REPORT_WEB_ENABLED=false
REPORT_WEB_MODEL=deepseek-v4-flash
REPORT_WEB_API_URL=https://api.deepseek.com
REPORT_WEB_API_KEY=
REPORT_WEB_TIMEOUT_SECONDS=20
REPORT_ILLUSTRATION_API_URL=
REPORT_PUBLIC_BASE_URL=https://api.example.com

# Backup files are created locally first. Copy them to a separate machine or
# object-storage bucket after each successful run.
BACKUP_DIR=deploy/backups
