# 已退役的旧 backend 非标端口配置，仅用于历史环境回滚。
# Theme V2 线上服务必须使用 Caddyfile.theme-v2 和 https://api.ureka.chat。
# 移动端不得使用裸 IP、明文 HTTP 或为该历史环境增加 ATS 例外。

https://{$DOMAIN} {
	tls /certs/fullchain.pem /certs/key.pem
	encode gzip

	reverse_proxy backend:8000 {
		# SSE: chat/flash/报告生成都是流式 —— 关闭缓冲让事件实时到达
		flush_interval -1
	}
}
